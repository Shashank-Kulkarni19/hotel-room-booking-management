{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "Dockerfile",
        "watchPatterns": [
            "src/**",
            "package.json",
            "vite.config.js"
        ]
    },
    "deploy": {
        "numReplicas": 1,
        "sleepOnIdle": true,
        "restartPolicyType": "ON_FAILURE"
    }
}